# Copy to .env.core and replace both password placeholders with the same strong value.
NEXA_MODE=core
POSTGRES_USER=nexa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexa
DATABASE_URL=postgresql+psycopg://nexa:change-me@postgres:5432/nexa
JWT_SECRET=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://localhost:5173
ALLOW_REGISTRATION=true
NEXA_HOST=0.0.0.0
NEXA_PORT=8000
