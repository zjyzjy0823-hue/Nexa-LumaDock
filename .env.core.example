# Copy to .env.core and replace both password placeholders with the same strong value.
STUDIOLO_MODE=core
POSTGRES_USER=studiolo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studiolo
DATABASE_URL=postgresql+psycopg://studiolo:change-me@postgres:5432/studiolo
JWT_SECRET=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://localhost:5173
ALLOW_REGISTRATION=true
STUDIOLO_HOST=0.0.0.0
STUDIOLO_PORT=8000
# Shared Space（/space）配置：若启用受控机密（protected）档，请替换为至少 32 字节的高熵随机密钥
STUDIOLO_SHARED_SPACE_ENABLED=true
STUDIOLO_VAULT_MASTER_KEY=replace-with-a-random-secret-at-least-32-bytes-long
# STUDIOLO_SPACE_BLOB_DIR=/var/lib/studiolo/space-blobs
# STUDIOLO_SPACE_MAX_FILE_BYTES=52428800
# STUDIOLO_SPACE_DEFAULT_QUOTA_BYTES=524288000
