{
  "name": "nexa",
  "private": true,
  "version": "0.5.7",
  "type": "module",
  "scripts": {
    "test:core-sync": "node --test tests/core-sync.test.mjs",
    "test:desktop": "node --experimental-strip-types --test tests/desktop-shortcuts.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:desktop": "vue-tsc --noEmit && vite build --mode desktop",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1",
    "desktop:prepare": "node scripts/desktop.mjs prepare",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:prepare:windows": "node scripts/desktop.mjs prepare --target x86_64-pc-windows-msvc",
    "desktop:prepare:macos": "node scripts/desktop.mjs prepare --target x86_64-apple-darwin",
    "desktop:build:windows": "node scripts/desktop.mjs build --target x86_64-pc-windows-msvc",
    "desktop:build:macos": "node scripts/desktop.mjs build --target x86_64-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
