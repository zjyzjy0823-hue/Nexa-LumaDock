{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexa",
  "mainBinaryName": "Nexa",
  "version": "0.5.5",
  "identifier": "com.isidel.nexa",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Nexa",
      "width": 1280,
      "height": 800,
      "minWidth": 960,
      "minHeight": 640,
      "center": true,
      "resizable": true,
      "visible": false
    }],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:17800 ws://127.0.0.1:17800 https://api.open-meteo.com https://geocoding-api.open-meteo.com",
        "img-src": "'self' data: https: http:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:17800 ws://127.0.0.1:5173 ws://127.0.0.1:17800 https://api.open-meteo.com https://geocoding-api.open-meteo.com",
        "img-src": "'self' data: https: http:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/nexa-backend"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["English", "SimpChinese"] } }
  }
}
