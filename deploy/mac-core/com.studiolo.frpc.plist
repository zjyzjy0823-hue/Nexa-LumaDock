<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.studiolo.frpc</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/frpc</string>
    <string>-c</string>
    <string>/Users/YOU/.studiolo-core/frpc.toml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/.studiolo-core/logs/frpc.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/.studiolo-core/logs/frpc.err.log</string>
</dict>
</plist>
