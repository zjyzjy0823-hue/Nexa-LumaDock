  {
    "action": "ledger.transaction.create",
    "toolName": "nexa_ledger_transaction_create",
    "effect": "write",
    "description": "ledger.transaction.create. Requires ledger:write. Returns entityId/entityType receipt; use a read tool to fetch content. Supply type (income/expense), positive amount, description and ISO occurredAt. categoryId is optional; list categories first to select a matching type.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "categoryId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Categoryid"
        },
        "type": {
          "enum": [
            "income",
            "expense"
          ],
          "title": "Type",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "description": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "occurredAt": {
          "format": "date-time",
          "title": "Occurredat",
          "type": "string"
        },
        "merchant": {
          "default": "",
          "maxLength": 120,
          "title": "Merchant",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 500,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "type",
        "amount",
        "description",
        "occurredAt"
      ],
      "title": "ledger_transactionCreate",
      "type": "object"
    }
  },
