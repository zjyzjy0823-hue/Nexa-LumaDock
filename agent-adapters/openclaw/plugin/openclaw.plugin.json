{
  "id": "studiolo-tools",
  "name": "Studiolo Local Tools",
  "description": "Access authorized Ledger, Websites and Data through Studiolo Local. Never bypass permission errors. Writes remain local until manual sync.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "serverUrl": {
        "type": "string",
        "description": "Trusted Studiolo Local URL; HTTPS for remote hosts."
      },
      "agentTokenEnv": {
        "type": "string",
        "description": "Environment variable holding the Agent token; default STUDIOLO_AGENT_TOKEN."
      },
      "adapterConfigPath": {
        "type": "string",
        "description": "Explicit shared runtime adapter config.json path. Never discover credential files automatically."
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "studiolo_status",
      "studiolo_ledger_categories_list",
      "studiolo_ledger_transactions_list",
      "studiolo_ledger_summary_get",
      "studiolo_website_categories_list",
      "studiolo_website_list",
      "studiolo_website_get",
      "studiolo_website_visit",
      "studiolo_data_collections_list",
      "studiolo_data_collection_get",
      "studiolo_data_records_list",
      "studiolo_data_record_get",
      "studiolo_ledger_category_create",
      "studiolo_ledger_category_update",
      "studiolo_ledger_category_delete",
      "studiolo_ledger_transaction_create",
      "studiolo_ledger_transaction_update",
      "studiolo_ledger_transaction_delete",
      "studiolo_website_category_create",
      "studiolo_website_category_update",
      "studiolo_website_category_delete",
      "studiolo_website_create",
      "studiolo_website_update",
      "studiolo_website_delete",
      "studiolo_data_collection_create",
      "studiolo_data_collection_update",
      "studiolo_data_collection_delete",
      "studiolo_data_record_create",
      "studiolo_data_record_update",
      "studiolo_data_record_delete"
    ]
  }
}
