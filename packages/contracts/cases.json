{
  "contractVersion": 3,
  "schemaFile": "schema/sync-v3.schema.json",
  "entityTypes": [
    "ledger.category",
    "ledger.transaction",
    "website.category",
    "website",
    "data.collection",
    "data.record",
    "user.preferences",
    "dashboard.layout",
    "automation.definition"
  ],
  "rejectionReasons": [
    "invalid_id",
    "invalid_fields",
    "invalid_operation",
    "invalid_base_revision",
    "invalid_data",
    "unknown_entity_type",
    "entity_id_unavailable",
    "category_not_found",
    "category_type_mismatch",
    "category_has_transactions",
    "collection_not_found",
    "collection_id_immutable",
    "delete_unsupported"
  ],
  "semanticRules": {
    "SR-1": "protocolVersion != 3 ⇒ HTTP 409, detail = sync_protocol_mismatch",
    "SR-2": "mutation.data 必须符合其 entityType 对应的实体 schema；违反 ⇒ result.status=rejected, reason=invalid_data",
    "SR-3": "operation=delete 时不得携带 data；违反 ⇒ rejected/invalid_data",
    "SR-4": "mutation 对象键必须 ⊆ {mutationId,entityType,entityId,operation,baseRevision,data}；违反 ⇒ rejected/invalid_fields",
    "SR-5": "changes.cursor 必须 ≤ workspaceRevision；违反 ⇒ HTTP 400 Invalid sync cursor",
    "SR-6": "changes 非空时 cursor 必须等于最后一条 change 的 revision；违反 ⇒ 契约破坏",
    "SR-7": "changes 的 revision 必须严格递增；违反 ⇒ 契约破坏",
    "SR-8": "operation=delete 的 change 必须 data=null；operation=upsert 必须 data 为对象；违反 ⇒ 契约破坏"
  },
  "entityDataSchemas": {
    "ledger.category": "LedgerCategoryData",
    "ledger.transaction": "LedgerTransactionData",
    "website.category": "WebsiteCategoryData",
    "website": "WebsiteData",
    "data.collection": "CollectionData",
    "data.record": "RecordData",
    "user.preferences": "PersonalStateData",
    "dashboard.layout": "PersonalStateData",
    "automation.definition": "PersonalStateData"
  },
  "cases": [
    {
      "name": "mutations-batch",
      "file": "samples/valid/mutations-batch.json",
      "schema": "MutationBatch",
      "kind": "valid"
    },
    {
      "name": "mutations-applied",
      "file": "samples/valid/mutations-applied.json",
      "schema": "MutationsResponse",
      "kind": "valid"
    },
    {
      "name": "mutations-mixed",
      "file": "samples/valid/mutations-mixed.json",
      "schema": "MutationsResponse",
      "kind": "valid"
    },
    {
      "name": "changes-page",
